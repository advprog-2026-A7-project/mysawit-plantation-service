worker_processes auto;
events { worker_connections 1024; }

http {
  upstream stable_pool {
    least_conn;
    server host.docker.internal:8182 max_fails=3 fail_timeout=10s;
    server host.docker.internal:8192 max_fails=3 fail_timeout=10s;
  }

  upstream canary_pool {
    server host.docker.internal:8282 max_fails=3 fail_timeout=10s;
  }

  # Hash by client IP+port → stable bucket assignment per client during a session.
  split_clients "${remote_addr}${remote_port}" $backend_pool {
    __CANARY_PCT__%    canary_pool;
    *                  stable_pool;
  }

  log_format canary '$remote_addr - $upstream_addr [$backend_pool] - $status - $request_time s - $request';
  access_log /var/log/nginx/access.log canary;

  server {
    listen 8089;
    server_name _;

    # Tiny endpoint to see split-result for the calling IP.
    location = /__backend {
      add_header Content-Type text/plain;
      return 200 "$backend_pool\n";
    }

    location / {
      proxy_pass http://$backend_pool;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Canary-Pool $backend_pool;
      proxy_connect_timeout 5s;
      proxy_read_timeout 60s;
    }
  }
}
