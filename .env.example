# =============================================================================
# MySawit Plantation Service - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Do not commit .env to version control.
#
# Bash-safe loading:
#   set -a; source .env; set +a
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
# Database password used by spring.datasource.password=${DB_PASSWORD}
DB_PASSWORD=replace_with_real_db_password

# JWT signing/verification secret used by JwtUtil
# Must be at least 32 bytes
JWT_SECRET=replace_with_long_random_secret_at_least_32_bytes

# -----------------------------------------------------------------------------
# Optional (with defaults already present in application.properties)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# RabbitMQ connection URL.
# Local RabbitMQ: amqp://guest:guest@localhost:5672/
# CloudAMQP: amqps://user:password@host/vhost
CLOUDAMQP_URL=amqp://guest:guest@localhost:5672/

# Identity service lookup for worker display names in assignment responses/events
IDENTITY_SERVICE_URL=http://localhost:8081
IDENTITY_SERVICE_INTERNAL_KEY=replace_with_identity_internal_key

# -----------------------------------------------------------------------------
# Optional Spring overrides (uncomment when needed)
# -----------------------------------------------------------------------------
# Override datasource URL/username for custom environments
SPRING_DATASOURCE_URL=jdbc:postgresql://db.luymlqdyfvvrmnepsgsj.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}
# App port (default in app is 8082; set 8080 for some container setups)
# SERVER_PORT=8082

# Used in OpenAPI server variable documentation
# APP_BASE_URL=https://api.mysawit.com
